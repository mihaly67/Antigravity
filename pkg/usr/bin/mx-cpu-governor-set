#!/bin/sh
GOV="$1"
if [ -z "$GOV" ]; then
    echo "Használat: $0 <kormányzó_neve>" >&2
    exit 1
fi

for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    if [ -f "$f" ]; then
        echo "$GOV" > "$f" 2>/dev/null || true
    fi
done

# Elmentés a következő SysVinit rendszerindításhoz
if [ -d /usr/share/mx-cpu-monitor ]; then
    echo "$GOV" > /usr/share/mx-cpu-monitor/governor.conf 2>/dev/null || true
    chmod 0666 /usr/share/mx-cpu-monitor/governor.conf 2>/dev/null || true
fi
if [ -n "$HOME" ]; then
    mkdir -p "$HOME/.config/mx-cpu-monitor" 2>/dev/null || true
    echo "$GOV" > "$HOME/.config/mx-cpu-monitor/governor.conf" 2>/dev/null || true
fi
if [ -w /etc/default ] || [ -w /etc/default/cpufrequtils ]; then
    printf 'ENABLE="true"\nGOVERNOR="%s"\nMAX_SPEED="0"\nMIN_SPEED="0"\n' "$GOV" > /etc/default/cpufrequtils 2>/dev/null || true
fi
