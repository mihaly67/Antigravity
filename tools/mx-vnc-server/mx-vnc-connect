#!/usr/bin/env bash
# MX VNC Smart Connector - Auto LAN / Tailscale Failover
# Kompatibilis: Debian 12 / MX Linux 23 / SysVinit / X11

MY_LAN=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')
MY_TS=$(tailscale ip -4 2>/dev/null)

if [ "$MY_LAN" = "192.168.1.105" ] || [ "$MY_TS" = "100.118.197.74" ]; then
    PEER_NAME="MX Másik Gép (192.168.1.106)"
    PEER_LAN="192.168.1.106"
    PEER_TS="100.95.215.75"
else
    PEER_NAME="MX-1 Xeon Gazdagép (192.168.1.105)"
    PEER_LAN="192.168.1.105"
    PEER_TS="100.118.197.74"
fi

# Elérési útvonal meghatározása (LAN prioritás, Tailscale tartalék)
if nc -zv -w 1 "$PEER_LAN" 5900 >/dev/null 2>&1; then
    TARGET="$PEER_LAN:5900"
    CONN_TYPE="Helyi LAN (Gigabit)"
elif [ -n "$PEER_TS" ] && nc -zv -w 1 "$PEER_TS" 5900 >/dev/null 2>&1; then
    TARGET="$PEER_TS:5900"
    CONN_TYPE="Biztonságos Tailscale VPN"
else
    TARGET="$PEER_LAN:5900"
    CONN_TYPE="Helyi LAN (Közvetlen)"
fi

# Jelszófájl megkeresése vagy létrehozása (alapértelmezett: 1104)
PW_FILE="$HOME/.vnc/passwd_xeon"
if [ ! -f "$PW_FILE" ]; then
    PW_FILE="$HOME/.vnc/passwd"
fi

if [ ! -f "$PW_FILE" ]; then
    mkdir -p "$HOME/.vnc"
    if which x11vnc >/dev/null 2>&1; then
        x11vnc -storepasswd "1104" "$HOME/.vnc/passwd" >/dev/null 2>&1 || true
        PW_FILE="$HOME/.vnc/passwd"
        chmod 600 "$PW_FILE" 2>/dev/null || true
    fi
fi

# Értesítés küldése
if which notify-send >/dev/null 2>&1; then
    notify-send -i preferences-desktop-remote-desktop "VNC Távoli Asztal Kapcsolódás" "$PEER_NAME\nKapcsolat típusa: $CONN_TYPE" -t 3500 2>/dev/null || true
fi

# TigerVNC megjelenítő indítása
if [ -f "$PW_FILE" ]; then
    exec /usr/bin/vncviewer -RemoteResize=0 -passwd "$PW_FILE" "$TARGET"
else
    exec /usr/bin/vncviewer -RemoteResize=0 "$TARGET"
fi
