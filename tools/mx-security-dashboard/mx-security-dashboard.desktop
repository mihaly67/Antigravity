[Desktop Entry]
Name=CyberSec Dashboard (Tálca)
Comment=Biztonsági Központ és Vírusvédelem indítása a tálcán
Exec=/usr/bin/mx-security-dashboard --hidden
Icon=/usr/share/icons/oxygen/base/128x128/status/security-high.png
Terminal=false
Type=Application
Categories=System;Security;
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
